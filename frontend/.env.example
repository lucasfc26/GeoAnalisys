# Copie para .env e preencha. O .env não vai para o Git.
# Os mapas de fundo (OpenStreetMap, satélite Esri) são gratuitos e não precisam de chave.

# Opcional: deve ser igual ao API_TOKEN do backend, se configurado.
VITE_API_TOKEN=

# Identificação gravada na auditoria
VITE_USER_ID=local

# Token público do Mapbox (pk.…) gravado nos mapas HTML de "Criar mapa". Também pode ser
# informado na própria janela.
VITE_MAPBOX_TOKEN=
